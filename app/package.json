{
  "name": "fons-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "start": "pnpm --filter frontend start",
    "lint": "pnpm --filter frontend lint",
    "backend:dev": "pnpm --filter backend dev",
    "backend:typecheck": "pnpm --filter backend typecheck",
    "backend:build": "pnpm --filter backend build",
    "backend:start": "pnpm --filter backend start",
    "frontend:typecheck": "pnpm --filter frontend typecheck",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:migrate:dev": "pnpm --filter backend db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter backend prisma:deploy",
    "db:push": "pnpm --filter backend db:push",
    "db:seed": "pnpm --filter backend db:seed",
    "db:seed:dev": "pnpm --filter backend db:seed:dev",
    "ci": "pnpm --filter backend db:generate && pnpm --filter backend typecheck && pnpm --filter backend build && pnpm --filter frontend typecheck && pnpm --filter frontend build && pnpm --filter frontend lint"
  }
}
