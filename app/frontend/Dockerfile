FROM node:22-bookworm

WORKDIR /app

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:3005
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3004
ARG NEXT_PUBLIC_APP_NAME="Fon's"
ARG NEXT_PUBLIC_WHATSAPP_NUMBER="+62 821-3333-7076"
ARG NEXT_PUBLIC_SERVICE_CITY=Yogyakarta
ARG NEXT_PUBLIC_TURNSTILE_ENABLED=false
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_WHATSAPP_NUMBER=$NEXT_PUBLIC_WHATSAPP_NUMBER
ENV NEXT_PUBLIC_SERVICE_CITY=$NEXT_PUBLIC_SERVICE_CITY
ENV NEXT_PUBLIC_TURNSTILE_ENABLED=$NEXT_PUBLIC_TURNSTILE_ENABLED
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY

COPY package.json ./
RUN npm install

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
