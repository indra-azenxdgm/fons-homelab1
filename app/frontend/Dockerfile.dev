FROM node:22-bookworm

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json

RUN npm install
RUN npm install --no-save lightningcss-linux-x64-gnu@$(node -p "require('./package-lock.json').packages['node_modules/lightningcss'].version") @tailwindcss/oxide-linux-x64-gnu@$(node -p "require('./package-lock.json').packages['node_modules/@tailwindcss/oxide'].version")

WORKDIR /app/frontend
